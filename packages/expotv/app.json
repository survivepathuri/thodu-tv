{
  "expo": {
    "scheme": "thodu",
    "plugins": [
      [
        "@react-native-tvos/config-tv",
        {
          "androidTVBanner": "../../assets/branding/banner-1280x720.png"
        }
      ],
      "expo-router",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false,
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a",
              "x86"
            ]
          }
        }
      ],
      "./plugins/withLowMemoryGradle.js",
      "./plugins/withGitVersionName.js",
      "expo-web-browser"
    ],
    "android": {
      "splash": {
        "image": "../../assets/branding/splash-mark-1152.png",
        "backgroundColor": "#FFF4DE"
      },
      "package": "com.thodu.tv",
      "permissions": [
        "INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ],
      "allowBackup": false
    },
    "experiments": {
      "autolinkingModuleResolution": true,
      "typedRoutes": true
    },
    "name": "Thodu",
    "slug": "thodu-tv",
    "version": "1.0.0",
    "icon": "../../assets/branding/icon-1024.png"
  }
}
