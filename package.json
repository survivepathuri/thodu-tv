{
  "name": "@thodu/workspace",
  "version": "0.1.0",
  "description": "Thodu - accessibility-first TV app for Fire TV / Android TV (Yarn workspaces monorepo)",
  "scripts": {
    "clean": "yarn workspaces foreach --all run clean ; rm -rf node_modules",
    "expotv": "yarn workspace @thodu/expotv",
    "expotv:prebuild": "yarn workspace @thodu/expotv run prebuild:tv",
    "expotv:android": "yarn workspace @thodu/expotv run android"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "nohoist": [
      "**/react",
      "**/react-dom",
      "**/react-native",
      "**/react-native/**"
    ]
  },
  "private": true,
  "packageManager": "yarn@4.5.0+sha512.837566d24eec14ec0f5f1411adb544e892b3454255e61fdef8fd05f3429480102806bac7446bc9daff3896b01ae4b62d00096c7e989f1596f2af10b927532f39"
}
